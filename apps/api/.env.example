# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/suinergy?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sui Network
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_WEBSOCKET_URL=wss://fullnode.testnet.sui.io:443

# Sui Walrus
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# Smart Contract Addresses (to be filled after deployment)
VAULT_PACKAGE_ID=
STRATEGY_PACKAGE_ID=
GOVERNANCE_PACKAGE_ID=

# Indexer Configuration
INDEXER_START_CHECKPOINT=0
INDEXER_BATCH_SIZE=100
INDEXER_POLL_INTERVAL=5000

# Job Scheduler
ENABLE_CRON_JOBS=true
APY_UPDATE_CRON=*/15 * * * *
LOYALTY_UPDATE_CRON=0 * * * *

# API Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
