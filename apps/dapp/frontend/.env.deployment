# DEPLOYMENT CONFIGURATION
# Copy this file to .env.local in the apps/dapp directory

NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUINERGY_PACKAGE_ID=0xb18e10c0d4cd763ae8f2d2972a6397d0d92f1638840a6f868f06d52683bf3d58
NEXT_PUBLIC_PROTOCOL_CONFIG_ID=0x7a1b696b29feb33c286b90791be4d7a5121b89d1bc63124827ffc921dd3f07e3

# TODO: Initialize vault and add the vault ID here
# Run: sui client call --package 0xb18e10c0d4cd763ae8f2d2972a6397d0d92f1638840a6f868f06d52683bf3d58 --module vault --function init_vault --type-args "0x2::sui::SUI" --gas-budget 10000000
# Then copy the Vault object ID from the output
NEXT_PUBLIC_VAULT_ID=

# Using SUI as placeholder for USDC/USDT (update when testnet tokens are available)
NEXT_PUBLIC_USDC_COIN_TYPE=0x2::sui::SUI
NEXT_PUBLIC_USDT_COIN_TYPE=0x2::sui::SUI

NEXT_PUBLIC_API_URL=http://localhost:4000
